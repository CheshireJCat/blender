{
  "name": "dsh-blender",
  "version": "0.2.4",
  "description": "DeepSeek Harness Blender production, reconstruction, validation, and export plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheshireJCat/blender.git"
  },
  "homepage": "https://github.com/CheshireJCat/blender#readme",
  "bugs": {
    "url": "https://github.com/CheshireJCat/blender/issues"
  },
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-blender-setup": "scripts/setup-analysis.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "skills",
    "requirements-analysis.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/compatibility-v0.2.3.md"
  ],
  "scripts": {
    "prepack": "node scripts/clean-package.js",
    "setup:analysis": "node scripts/setup-analysis.js",
    "test": "node --test",
    "test:blender": "RUN_BLENDER_TESTS=1 node --test test/blender.integration.test.js",
    "test:helpers": "RUN_HELPER_TESTS=1 node --test test/helpers.integration.test.js",
    "test:dsh": "node test-support/dsh-profile-smoke.js",
    "validate": "node scripts/validate-package.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "blender",
    "3d-modeling",
    "agent-skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-alpha.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-alpha.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        }
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1 || ^3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
