{
  "name": "dsh-blender",
  "version": "0.2.0",
  "description": "Full DeepSeek Harness Blender production, reconstruction, validation, and export plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheshireJCat/blender.git"
  },
  "homepage": "https://github.com/CheshireJCat/blender#readme",
  "bugs": {
    "url": "https://github.com/CheshireJCat/blender/issues"
  },
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-blender-setup": "scripts/setup-analysis.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "skills",
    "requirements-analysis.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "node scripts/clean-package.js",
    "setup:analysis": "node scripts/setup-analysis.js",
    "test": "node --test",
    "test:blender": "RUN_BLENDER_TESTS=1 node --test test/blender.integration.test.js",
    "test:helpers": "RUN_HELPER_TESTS=1 node --test test/helpers.integration.test.js",
    "validate": "node scripts/validate-package.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "blender",
    "3d-modeling",
    "agent-skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
