{
  "name": "dsh-blender",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for safe, workspace-scoped Blender 3D modeling",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "scripts",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:blender": "RUN_BLENDER_TESTS=1 node --test test/blender.integration.test.js",
    "validate": "node scripts/validate-package.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "blender",
    "3d-modeling",
    "agent-skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
